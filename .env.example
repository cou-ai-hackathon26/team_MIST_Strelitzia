# --- LLM (OpenCode Go, Anthropic-format endpoint) ---
OPENCODE_API_KEY=your-opencode-go-key
LLM_BASE_URL=https://opencode.ai/inference/go/anthropic/v1
LLM_MODEL=claude-haiku-5-5
LLM_USER_AGENT=prohori/0.1
# --- brain ---
BRAIN_PORT=4400
BRAIN_API_TOKEN=dev-brain-token-change-me
BRAIN_DB_PATH=./data/prohori.db
# Pre-seeded dev hosts (id:name:token) for the docker targets
SEED_HOSTS=web-a:bank-web-01:dev-token-a,web-b:bank-web-02:dev-token-b,batch-c:bank-batch-01:dev-token-c
DEMO_REPLAY_HOLD=CVE-2026-109618,CVE-2026-109619
# --- email (MailHog) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
REPORT_FROM=prohori@bank.local
DEFAULT_REPORT_EMAILS=it-security@bank.local,soc@bank.local
# --- web ---
ADMIN_PASSWORD=prohori-admin
BRAIN_URL=http://127.0.0.1:4400
SESSION_SECRET=dev-session-secret-change-me
ADMIN_USERS=rahim:change-me,nusrat:change-me
