# Prohori — environment configuration
# Copy to `.env` in the repository root:   cp .env.example .env
# Both the Sentinel brain (apps/brain) and the dashboard (apps/web) read this file.

# ── LLM (Sentinel's model) ──────────────────────────────────────────────
# OpenCode Go, Anthropic-format endpoint. Any Anthropic-compatible endpoint works.
OPENCODE_API_KEY=your-opencode-go-key
LLM_BASE_URL=https://opencode.ai/inference/go/anthropic/v1
LLM_MODEL=claude-haiku-5-5
LLM_USER_AGENT=prohori/0.1

# ── Sentinel brain (apps/brain) ─────────────────────────────────────────
BRAIN_PORT=4400
# Shared secret between the dashboard and the brain API. Change for any real deployment.
BRAIN_API_TOKEN=dev-brain-token-change-me
# SQLite database (relative to apps/brain). Chat memory is stored next to it (mastra.db).
BRAIN_DB_PATH=./data/prohori.db
# Pre-enrolled lab assets for the Docker targets: id:name:token, comma-separated.
SEED_HOSTS=web-a:bank-web-01:dev-token-a,web-b:bank-web-02:dev-token-b,batch-c:bank-batch-01:dev-token-c,ssh-d:bank-ssh-01:dev-token-d
# Demonstration scenario labels (shown in the demo controls). Scans themselves are gated by "Allow CVE Scan"
# in Settings → Demonstration Controls, which a reset switches off again.
DEMO_REPLAY_HOLD=CVE-2026-109618,CVE-2026-109619,CVE-2024-6387
# Scenarios: id:Title:CVE,CVE;id:Title:CVE
DEMO_SCENARIOS=php2shell:PHP2Shell:CVE-2026-109618,CVE-2026-109619;regresshion:regreSSHion:CVE-2024-6387
# Optional: URL daemons use to reach the brain, shown in "Add Asset" install commands.
# BRAIN_PUBLIC_URL=ws://192.168.1.10:4400/agent
# Optional: delay before the first scan after startup (ms, default 20000).
# FIRST_SCAN_DELAY_MS=20000

# ── Email (reports) ─────────────────────────────────────────────────────
# The Docker stack runs Mailpit on 1025 (SMTP) / 8025 (web inbox).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
REPORT_FROM=prohori@bank.local
DEFAULT_REPORT_EMAILS=it-security@bank.local,soc@bank.local

# ── Dashboard (apps/web) ────────────────────────────────────────────────
BRAIN_URL=http://127.0.0.1:4400
SESSION_SECRET=dev-session-secret-change-me
# Admin accounts: username:password, comma-separated. Change for any real deployment.
ADMIN_USERS=zamil:prohori-admin,nusrat:prohori-admin
# Fallback single account (user "admin") if ADMIN_USERS is empty.
ADMIN_PASSWORD=prohori-admin
# Set to 1 when serving the dashboard over HTTPS in production.
# COOKIE_SECURE=1

# Always suppressed from scans/results (demo). The Advisory Judge ignores this list (an admin asked explicitly),
# and a CVE tracked from a judgment is re-checked by scans again. The Advisory Judge demo uses:
#   CVE-2026-129483 (Cyrus SASL SRP bypass), CVE-2023-54419 (nginxWebUI RCE; lab stub on bank-web-01),
#   CVE-2026-123007,CVE-2026-123633 (nginx HTTP/2; hidden so they don't clutter the demo)
DEMO_IGNORE_CVES=
# Assets investigated in parallel by scans, advisory judgments and re-checks (1-16)
# SCAN_CONCURRENCY=6
# Daemons send a full inventory every INVENTORY_SEC; a server whose inventory is older than INVENTORY_STALE_SEC
# (default max(300, 2.5 × INVENTORY_SEC)) "cannot be assessed": no scans, re-checks or proposals for it.
# INVENTORY_SEC=120
# INVENTORY_STALE_SEC=300
