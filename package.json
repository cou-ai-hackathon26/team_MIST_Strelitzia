{
  "name": "prohori",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "brain": "cd apps/brain && bun run dev",
    "web": "cd apps/web && bun run dev",
    "daemon:build": "cd apps/daemon && bun run build",
    "targets:up": "docker compose -f infra/docker-compose.yml up -d --build",
    "targets:down": "docker compose -f infra/docker-compose.yml down"
  }
}